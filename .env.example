# Copier en .env (jamais commité). Les variables d'environnement sont prioritaires.

# Secret de signature des JWT (32 caractères minimum) — obligatoire en profil prod
# openssl rand -base64 48
JWT_SECRET=

# Base de données (profil prod) : Supabase mutualisée, pooler en mode session, schéma dédié
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=
# DB_SCHEMA=meteo_api
# DB_POOL_SIZE=3

# Compte de service des applications clientes (platform-back) : e-mail + hash BCrypt du mot de passe
# Hash : htpasswd -bnBC 10 "" 'mot-de-passe' | tr -d ':\n' | sed 's/$2y/$2a/'
METEO_SERVICE_EMAIL=platform@meteo.local
METEO_SERVICE_PASSWORD_HASH=

# Comptes de démonstration admin / user : contexte "dev" (défaut). En production : prod
# LIQUIBASE_CONTEXTS=prod

# v1 (codes INSEE) : URL de meteo-scheduling
# METEO_BATCH_URL=http://localhost:8082
# PORT=8081
