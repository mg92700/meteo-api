<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Création de la table -->
    <changeSet id="create_table_user_app" author="admin">
        <createTable tableName="user_app">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="firstname" type="VARCHAR(255)"/>
            <column name="lastname" type="VARCHAR(255)"/>
            <column name="role" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- Création de la séquence (à utiliser si besoin dans du SQL natif) -->
    <changeSet id="create_sequence_user_app_seq" author="admin">
        <sql>
            CREATE SEQUENCE USER_SEQ START WITH 1 INCREMENT BY 1;
        </sql>
    </changeSet>

    <!-- Insertion de données (attention à bien respecter la casse des colonnes) -->
    <changeSet id="insert-user-app-data" author="admin">
        <insert tableName="user_app">
            <column name="email" value="admin"/>
            <column name="password" value="$2a$10$Q8bLaPBDvYD6lpOfwWTzFuNQLqFSYMEGC97i64HZr54gtjguKgTc2"/>
            <column name="firstname" value="admin"/>
            <column name="lastname" value="admin"/>
            <column name="role" value="ADMIN"/>
        </insert>
        <insert tableName="user_app">
            <column name="email" value="user"/>
            <column name="password" value="$2a$10$Q8bLaPBDvYD6lpOfwWTzFuNQLqFSYMEGC97i64HZr54gtjguKgTc2"/>
            <column name="firstname" value="user"/>
            <column name="lastname" value="user"/>
            <column name="role" value="USER"/>
        </insert>
    </changeSet>
</databaseChangeLog>
